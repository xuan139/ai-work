[Unit]
Description=AI Work Qwen3 CPU Embedding Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ai-work
Environment=CUDA_VISIBLE_DEVICES=-1
Environment=HF_HOME=/home/ubuntu/ai-work/storage/models/huggingface
Environment=TOKENIZERS_PARALLELISM=false
Environment=OMP_NUM_THREADS=6
Environment=MKL_NUM_THREADS=6
Environment=EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
Environment=EMBEDDING_MODEL_ALIAS=qwen3-embedding-0.6b
Environment=EMBEDDING_DIMENSION=1024
ExecStart=/home/ubuntu/ai-work/.venv-embedding/bin/uvicorn app.embedding_service:app --host 127.0.0.1 --port 8081 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
