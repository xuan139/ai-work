[Unit]
Description=AI Work read-only manufacturing QMS and CMMS MCP
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ai-work
ExecStart=/home/ubuntu/factory-mes-venv/bin/python -m app.manufacturing_support_mcp
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
