[Unit]
Description=AI Work teaching-only Orthanc archive
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/home/ubuntu/ai-work/storage/orthanc/bin/Orthanc /home/ubuntu/ai-work/storage/orthanc/config.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/ai-work/storage/orthanc

[Install]
WantedBy=multi-user.target
