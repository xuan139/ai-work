# AI Work Core native Ubuntu settings
AI_WORK_VERSION=development
AI_WORK_BIND_HOST=0.0.0.0
AI_WORK_HTTP_PORT=8000
AI_WORK_PUBLIC_URL=http://localhost:8000
# Change to production only after HTTPS is configured. Production mode rejects weak secrets and HTTP URLs.
AI_WORK_ENV=development
AI_WORK_COOKIE_SECURE=false
AI_WORK_FORWARDED_ALLOW_IPS=127.0.0.1

# Generated by install.sh. Use at least 32 random characters.
APP_SECRET_KEY=replace-with-a-random-secret
NAS_SSD_LOCAL_MCP_KEY=replace-with-a-separate-random-secret
SSD_CLI_HELPER=/usr/local/sbin/ai-work-ssd-cli

# Used only when the initial database creates the admin account.
# Must contain at least 12 characters. Change it in Account Management after login.
AI_WORK_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional services running on the same Ubuntu server.
NAS_LLM_BASE_URL=http://127.0.0.1:8080
EMBEDDING_BASE_URL=http://127.0.0.1:8081
AI_WORK_DEFAULT_LLM_MODEL_ID=local:qwen3-4b

# Upload and worker defaults.
AI_WORK_MAX_UPLOAD_BYTES=2147483648
MEDIA_WORKER_COUNT=1
AI_WORK_LOGIN_ATTEMPTS=5
AI_WORK_LOGIN_WINDOW_SECONDS=900
AI_WORK_LLM_REQUESTS_PER_MINUTE=60
# Optional root-readable file used by backup.sh for AES-256 encrypted backups.
# AI_WORK_BACKUP_PASSPHRASE_FILE=/etc/ai-work/backup.pass
ASR_CHINESE_SCRIPT=traditional
YOLO_DEVICE=cpu

# Add cloud provider keys only when the company authorizes those providers.
# QWEN_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
